<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Collapsing app bar with illustration -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarDetail"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/primary_container"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/background">

            <!-- Baby illustration / activity image -->
            <ImageView
                android:id="@+id/imageDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/primary_container"
                app:layout_collapseMode="parallax"
                android:contentDescription="@string/activity_details" />

            <!-- Back button toolbar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIcon="@drawable/ic_back"
                app:navigationIconTint="@color/text_primary"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable detail content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Star rating + social proof -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <!-- Stars -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star_filled" android:contentDescription="star" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star_filled" android:contentDescription="star" android:layout_marginStart="2dp" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star_filled" android:contentDescription="star" android:layout_marginStart="2dp" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star_filled" android:contentDescription="star" android:layout_marginStart="2dp" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_star_filled" android:contentDescription="star" android:layout_marginStart="2dp" />
                </LinearLayout>

                <!-- Done by babies count -->
                <TextView
                    android:id="@+id/textDoneByBabies"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Done by 10,328 Babies"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="10dp" />

                <!-- Doctor verified badge -->
                <LinearLayout
                    android:id="@+id/layoutVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_doctor_verified" android:contentDescription="verified" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/doctor_verified" android:textSize="11sp" android:textColor="@color/primary" android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Difficulty buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/btnTooEasy"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/too_easy"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_difficulty_button"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnTooHard"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/too_hard"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_difficulty_button"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Section label: category (pink) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_section_header_pink"
                android:paddingHorizontal="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/textSectionCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Infancy and Attention"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFAD1457"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Section label: activity title (teal) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_section_header_teal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.6"
                android:paddingHorizontal="20dp"
                android:paddingBottom="12dp" />

            <!-- Frequency badge -->
            <LinearLayout
                android:id="@+id/layoutFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_teal_button"
                android:paddingHorizontal="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/once_a_day"
                    android:textSize="12sp"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Benefits section -->
            <TextView
                android:id="@+id/labelBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/benefits_label"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="20dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.5"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone" />

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"
                android:id="@+id/dividerMaterials"
                android:visibility="gone" />

            <!-- Materials section -->
            <TextView
                android:id="@+id/labelMaterials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/materials_label"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:paddingHorizontal="20dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textMaterials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.5"
                android:paddingHorizontal="20dp"
                android:paddingBottom="24dp"
                android:visibility="gone" />

            <!-- Mark as done button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonComplete"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/mark_done"
                android:textSize="15sp"
                android:backgroundTint="@color/primary"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading overlay -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
