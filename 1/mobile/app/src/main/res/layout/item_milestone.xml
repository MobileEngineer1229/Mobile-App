<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_background"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp">

    <!-- Number + Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textMilestoneNumber"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textStyle="normal"
            android:text="1." />

        <TextView
            android:id="@+id/textMilestoneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>

    <!-- Yes / No / Almost buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btnStatusYes"
            android:layout_width="76dp"
            android:layout_height="34dp"
            android:text="@string/milestone_yes"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:background="@drawable/bg_status_unselected"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnStatusNo"
            android:layout_width="76dp"
            android:layout_height="34dp"
            android:text="@string/milestone_no"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:background="@drawable/bg_status_unselected"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnStatusAlmost"
            android:layout_width="76dp"
            android:layout_height="34dp"
            android:text="@string/milestone_almost"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:background="@drawable/bg_status_unselected"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Related Activities expandable row -->
    <LinearLayout
        android:id="@+id/rowRelatedActivities"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/related_activities"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iconRelatedActivitiesChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/arrow_down_float"
            android:layout_marginEnd="4dp"
            android:contentDescription="Expand" />
    </LinearLayout>

    <!-- Related Activities content (collapsed by default) -->
    <LinearLayout
        android:id="@+id/layoutRelatedActivitiesContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textRelatedActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.3"
            android:paddingTop="4dp" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

</LinearLayout>
