<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDF6EE">

    <!-- ══ HEADER: peach→coral gradient ══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Gradient header content -->
        <LinearLayout
            android:id="@+id/headerGrowth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="44dp">

            <!-- Back + Title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="8dp"
                    android:tint="#2B1F1A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/growth_tracker"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#2B1F1A" />
            </LinearLayout>

            <!-- Weight / Height toggle pill -->
            <LinearLayout
                android:id="@+id/tabContainer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_tab_toggle_border"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabWeight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/weight"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#D96E4B"
                    android:background="@drawable/bg_tab_white_pill"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tabHeight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/height"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Wave curve -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:src="@drawable/ic_wave_cream"
            android:scaleType="fitXY"
            android:layout_gravity="bottom"
            android:contentDescription="" />
    </FrameLayout>

    <!-- ══ CONTENT: cream background ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FDF6EE"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!-- Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Chart title row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <!-- Title + ℹ -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/textChartTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/weight_chart"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="#2B1F1A" />

                            <TextView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="8dp"
                                android:text="i"
                                android:textSize="10sp"
                                android:textColor="#9A8A80"
                                android:gravity="center"
                                android:background="@drawable/bg_info_circle" />
                        </LinearLayout>

                        <!-- SI / IMP toggle -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_tab_unselected"
                            android:padding="3dp">

                            <TextView
                                android:id="@+id/btnSI"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SI"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/bg_coral_tab"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/btnIMP"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IMP"
                                android:textSize="11sp"
                                android:textColor="#5C4A42"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Custom growth chart view -->
                    <com.talentbaby.app.ui.growth.GrowthChartView
                        android:id="@+id/growthChart"
                        android:layout_width="match_parent"
                        android:layout_height="190dp" />

                    <!-- Age range navigator -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp">

                        <ImageButton
                            android:id="@+id/btnRangePrev"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_chevron_left"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="#D96E4B"
                            android:contentDescription="Previous" />

                        <TextView
                            android:id="@+id/textAgeRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Month - 6 Month"
                            android:textSize="13sp"
                            android:textColor="#D96E4B"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnRangeNext"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_chevron_right"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="#D96E4B"
                            android:contentDescription="Next" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Your Data placeholder card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/your_data_here"
                    android:textSize="14sp"
                    android:textColor="#9A8A80"
                    android:gravity="center"
                    android:padding="30dp" />
            </androidx.cardview.widget.CardView>

            <!-- Add Data button -->
            <TextView
                android:id="@+id/btnAddData"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/add_data"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/bg_coral_pill"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
