<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked state (ON): Primary blue - circle on left -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="12dp" />
            <size
                android:width="44dp"
                android:height="24dp" />
        </shape>
    </item>
    
    <!-- Unchecked state (OFF): #35383F dark gray - circle on right -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_5" />
            <corners android:radius="12dp" />
            <size
                android:width="44dp"
                android:height="24dp" />
        </shape>
    </item>
</selector>
