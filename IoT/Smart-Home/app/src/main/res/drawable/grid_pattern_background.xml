<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark green background -->
    <item>
        <color android:color="#1A2E2A" />
    </item>
    
    <!-- Vertical grid lines - using shape with stroke pattern -->
    <!-- This creates a subtle grid effect -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#2A3F3A"
                android:dashWidth="80dp"
                android:dashGap="20dp" />
        </shape>
    </item>
</layer-list>
