<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_1"
    tools:context=".ui.MainActivity">

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollViewMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="64dp">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textViewMyHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_home"
                        style="@style/TextAppearance.Urbanist.H4.Bold"
                        android:textColor="@color/white"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <ImageButton
                        android:id="@+id/buttonDropdown"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_chevron_down"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/my_home"
                        app:tint="@color/white" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/buttonRobot"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="AI Assistant Bobo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bobo_mascot" />

                <!-- Notification Button with Badge -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/buttonNotifications"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_notifications"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Notifications"
                        app:tint="@color/white" />

                    <View
                        android:id="@+id/notificationBadge"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/notification_badge"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- Weather Widget -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/weather_widget_background"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20 °C"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:fontFamily="@font/urbanist"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/textViewLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/new_york_city_usa"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/urbanist"
                            android:alpha="0.9"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/textViewWeatherCondition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/today_cloudy"
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/urbanist"
                            android:alpha="0.9"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AQI 92"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/urbanist"
                                android:alpha="0.8"
                                android:layout_marginEnd="16dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="78.2%"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/urbanist"
                                android:alpha="0.8"
                                android:layout_marginEnd="16dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2.0 m/s"
                                android:textSize="14sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/urbanist"
                                android:alpha="0.8" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Weather Icon Placeholder -->
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@android:drawable/ic_menu_view"
                        android:contentDescription="Weather"
                        android:tint="@color/white"
                        android:alpha="0.5" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Category Summary Cards -->
            <LinearLayout
                android:id="@+id/categoryCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp">

                <!-- Lightning Card -->
                <LinearLayout
                    android:id="@+id/cardLightning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/category_card_lightning"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/device_category_lighting"
                        android:scaleType="fitCenter"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lightning"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/urbanist"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewLightningCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 lights"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/urbanist"
                        android:alpha="0.8" />

                </LinearLayout>

                <!-- Cameras Card -->
                <LinearLayout
                    android:id="@+id/cardCameras"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/category_card_cameras"
                    android:padding="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/white"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cameras"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/urbanist"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewCamerasCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 cameras"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/urbanist"
                        android:alpha="0.8" />

                </LinearLayout>

                <!-- Electrical Card -->
                <LinearLayout
                    android:id="@+id/cardElectrical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/category_card_electrical"
                    android:padding="16dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/device_category_electrical"
                        android:scaleType="fitCenter"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/electronics"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/urbanist"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewElectricalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 devices"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/urbanist"
                        android:alpha="0.8" />

                </LinearLayout>

            </LinearLayout>

            <!-- All Devices Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/all_devices"
                        style="@style/TextAppearance.Urbanist.H5.Bold"
                        android:textColor="@color/white" />

                    <ImageButton
                        android:id="@+id/buttonMoreOptions"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_more_vert"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="More options"
                        android:tint="@color/white" />

                </LinearLayout>

                <!-- Room Filters -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/roomFiltersContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <!-- Room filters will be added dynamically from backend data -->
                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Device List or Empty State -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:visibility="gone"
                tools:listitem="@layout/item_device" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:visibility="visible">

                <!-- Two Overlapping Clipboard Icons -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/clipboard_icon"
                        android:contentDescription="@string/no_devices"
                        android:layout_gravity="start|top" />

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/clipboard_icon"
                        android:contentDescription="@string/no_devices"
                        android:layout_gravity="end|bottom" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_devices"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="@font/urbanist"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/you_havent_added_device"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/urbanist"
                    android:alpha="0.7"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonAddDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="72dp"
                    android:text="@string/add_device"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/urbanist"
                    android:letterSpacing="0.02"
                    android:backgroundTint="@color/primary"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconGravity="start"
                    app:iconSize="20dp"
                    app:iconPadding="8dp"
                    app:cornerRadius="1000dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Mask Overlay (shown when popup is visible) -->
    <View
        android:id="@+id/maskOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#9909101D"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="0dp" />

    <!-- Pill-shaped Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMic"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@color/grey_800"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="28dp"
            app:elevation="8dp"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabAddDevice"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:elevation="8dp"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabClose"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:visibility="gone"
            app:icon="@drawable/ic_close"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white"
            android:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:elevation="8dp"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@color/dark_1"
        android:elevation="16dp"
        style="@style/CustomBottomNavigationView"
        app:itemIconTint="@null"
        app:itemTextColor="@color/nav_item_color_selector"
        app:itemBackground="@drawable/bottom_nav_item_background"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:itemTextAppearanceActive="@style/BottomNavTextStyleActive"
        app:itemTextAppearanceInactive="@style/BottomNavTextStyle"
        app:menu="@menu/bottom_navigation" />

    <!-- Loading Overlay -->
    <include
        android:id="@+id/loadingOverlay"
        layout="@layout/component_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
