<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary">

    <!-- Phone Mockup Container - Design: 345px x 700px, margins: 43px left/right, 12px top -->
    <!-- Design base: 432px x 888px (excluding 44px header) -->
    <!-- Phone width: 345/432 = 79.9%, height: 700/888 = 78.8% -->
    <!-- Margins: 43px left/right, 12px top -->
    <FrameLayout
        android:id="@+id/phoneContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.799"
        app:layout_constraintHeight_percent="0.788"
        app:layout_constraintDimensionRatio="345:700">

        <!-- Phone Content Background - onboarding_background3 -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:adjustViewBounds="false"
            android:src="@drawable/onboarding_background3"
            android:contentDescription="@string/onboarding_phone_content" />
        
    </FrameLayout>

    <!-- Mask Overlay - Design: 430px x 460px, margin top: 472px -->
    <!-- Design base: 432px x 888px (excluding 44px header) -->
    <!-- Mask width: 430/432 = 99.5% (almost full width), height: 460/888 = 51.8% -->
    <!-- Mask top: 472/888 = 53.2% from top -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/maskTopGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.46" />

    <!-- Guideline for LinearLayout position: 521px from top -->
    <!-- 521px / 888px = 0.587 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomContentTopGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.57" />

    <ImageView
        android:id="@+id/maskOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/onboarding_mask"
        app:layout_constraintTop_toBottomOf="@id/maskTopGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="1"
        app:layout_constraintHeight_percent="0.6" >
    </ImageView>

    <LinearLayout
        android:id="@+id/bottomContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_12"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/bottomContentTopGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Headline -->
        <TextView
            android:id="@+id/textViewHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_headline_3"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_xxlarge"
            android:textStyle="bold"
            android:fontFamily="@font/urbanist"
            android:gravity="center"
            android:lineHeight="@dimen/text_size_xxxlarge"
            android:letterSpacing="0.02"
            android:layout_marginBottom="@dimen/spacing_16" />

        <!-- Description -->
        <TextView
            android:id="@+id/textViewDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_description_3"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:lineHeight="@dimen/text_size_xxlarge"
            android:fontFamily="@font/urbanist"
            android:alpha="0.8"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_32" />

        <!-- Pagination Dots -->
        <LinearLayout
            android:id="@+id/paginationDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/spacing_32">

            <View
                android:id="@+id/dot1"
                android:layout_width="@dimen/spacing_8"
                android:layout_height="@dimen/spacing_8"
                android:layout_marginEnd="@dimen/spacing_8"
                android:background="@drawable/dot_inactive" />

            <View
                android:id="@+id/dot2"
                android:layout_width="@dimen/spacing_8"
                android:layout_height="@dimen/spacing_8"
                android:layout_marginEnd="@dimen/spacing_8"
                android:background="@drawable/dot_inactive" />

            <View
                android:id="@+id/dot3"
                android:layout_width="@dimen/spacing_8"
                android:layout_height="@dimen/spacing_8"
                android:background="@drawable/dot_active" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider Above Buttons -->
    <View
        android:id="@+id/dividerAboveButtons"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#20FFFFFF"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/spacing_12"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_12"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonContinue"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:text="@string/get_started"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/urbanist"
            android:letterSpacing="0.02"
            android:backgroundTint="@color/primary"
            app:cornerRadius="1000dp"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

    <!-- Bottom Content -->

</androidx.constraintlayout.widget.ConstraintLayout>
