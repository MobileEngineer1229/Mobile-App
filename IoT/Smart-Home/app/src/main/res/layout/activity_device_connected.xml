<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_1">

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- Checkmark Icon in Blue Circle -->
            <ImageView
                android:id="@+id/imageViewCheckmark"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/checkmark_circle_blue"
                android:contentDescription="Connected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Connected! Title -->
            <TextView
                android:id="@+id/textViewConnected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/urbanist"
                android:text="@string/connected"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/imageViewCheckmark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Connected Message -->
            <TextView
                android:id="@+id/textViewConnectedMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You have connected to Smart VI CCTV."
                android:textSize="16sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/textViewConnected"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Device Image -->
            <ImageView
                android:id="@+id/imageViewDevice"
                android:layout_width="340dp"
                android:layout_height="340dp"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="Device"
                android:scaleType="fitCenter"
                android:layout_marginTop="48dp"
                app:layout_constraintTop_toBottomOf="@id/textViewConnectedMessage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Show QR Code Button (visible only for MQTT devices) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonShowQR"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/show_qr_code"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:fontFamily="@font/urbanist"
                android:textStyle="bold"
                android:backgroundTint="@android:color/transparent"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                app:cornerRadius="24dp"
                app:rippleColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/imageViewDevice"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Divider Line Above Buttons -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Action Buttons Container -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Go to Homepage Button -->

        <!-- Control Device Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGoHome"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:backgroundTint="@color/dark_4"
            android:fontFamily="@font/urbanist"
            android:text="@string/go_to_homepage"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="100dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonControlDevice"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:text="@string/control_device"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/urbanist"
            android:backgroundTint="@color/primary"
            app:cornerRadius="100dp"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
