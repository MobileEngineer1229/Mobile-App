<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_1">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/dark_1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:tint="@color/white" />

    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/enter_otp_code_title"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:fontFamily="@font/urbanist"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Description -->
    <TextView
        android:id="@+id/textViewDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/enter_otp_description"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:fontFamily="@font/urbanist"
        android:gravity="start"
        android:lineSpacingMultiplier="1.6"
        android:letterSpacing="0.002"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/textViewTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- OTP Input Container -->
    <LinearLayout
        android:id="@+id/otpContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/textViewDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextOTP1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:maxLength="1"
            android:inputType="number"
            android:textSize="24sp"
            android:fontFamily="@font/urbanist"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/otp_input_background"
            android:cursorVisible="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextOTP2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:maxLength="1"
            android:inputType="number"
            android:textSize="24sp"
            android:fontFamily="@font/urbanist"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/otp_input_background"
            android:cursorVisible="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextOTP3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:maxLength="1"
            android:inputType="number"
            android:textSize="24sp"
            android:fontFamily="@font/urbanist"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/otp_input_background"
            android:cursorVisible="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextOTP4"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:maxLength="1"
            android:inputType="number"
            android:textSize="24sp"
            android:fontFamily="@font/urbanist"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/otp_input_background"
            android:cursorVisible="false"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <!-- Resend Timer -->
    <TextView
        android:id="@+id/textViewResendTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:fontFamily="@font/urbanist"
        android:textColor="@color/white"
        android:alpha="0.7"
        android:layout_marginTop="24dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/otpContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Resend Code Link -->
    <TextView
        android:id="@+id/textViewResendCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resend_code"
        android:textSize="18sp"
        android:fontFamily="@font/urbanist"
        android:textColor="@color/white"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/textViewResendTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Numeric Keypad -->
    <LinearLayout
        android:id="@+id/keypadContainer"
        android:background="@drawable/otp_input_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/keypad1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="1"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/keypad2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="2"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/keypad3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="3"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Row 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/keypad4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="4"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/keypad5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="5"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/keypad6"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="6"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Row 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/keypad7"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="7"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/keypad8"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="8"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/keypad9"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="9"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Row 4: *, 0, Backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/keypadAsterisk"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="*"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/keypad0"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="0"
                android:textSize="24sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/keypadBackspace"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="⌫"
                android:textSize="20sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
