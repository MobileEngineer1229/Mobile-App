<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <!-- Mode Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp"
        android:padding="4dp"
        android:background="@drawable/tab_container_background_new">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonWhite"
            style="@style/Widget.SmartHome.TabButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="42dp"
            android:background="@drawable/tab_selected_background_rounded"
            android:textAppearance="@style/TextAppearance.Urbanist.Large.Bold"
            android:text="White"
            android:textColor="@color/white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonColor"
            style="@style/Widget.SmartHome.TabButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="42dp"
            android:background="@drawable/tab_unselected_background_rounded"
            android:textAppearance="@style/TextAppearance.Urbanist.Large.Bold"
            android:text="Color"
            android:textColor="@color/white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonScene"
            style="@style/Widget.SmartHome.TabButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="42dp"
            android:background="@drawable/tab_unselected_background_rounded"
            android:textAppearance="@style/TextAppearance.Urbanist.Large.Bold"
            android:text="Scene"
            android:textColor="@color/white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="0dp" />

    </LinearLayout>

    <!-- White Mode Controls -->
    <LinearLayout
        android:id="@+id/whiteModeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="32dp">

        <!-- Temperature Control Arc (Donut/Semi-circle) -->
        <FrameLayout
            android:layout_width="370dp"
            android:layout_height="370dp"
            android:layout_marginBottom="32dp"
            android:padding="20dp"
            android:gravity="center">

            <!-- Semi-circular Arc Control -->
            <com.smarthome.iot.ui.views.TemperatureArcView
                android:id="@+id/temperatureArcView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- Light Bulb Image in Center (Dark Circle Background) -->
            <androidx.cardview.widget.CardView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                app:cardCornerRadius="90dp"
                app:cardBackgroundColor="@color/dark_4"
                app:cardElevation="0dp"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/imageViewLightBulb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/lamp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Light bulb"
                    android:tint="@color/white" />

            </androidx.cardview.widget.CardView>

        </FrameLayout>

    </LinearLayout>

    <!-- Color Mode Controls -->
    <LinearLayout
        android:id="@+id/colorModeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="32dp">

        <!-- Color Wheel with Light Bulb in Center -->
        <FrameLayout
            android:layout_width="370dp"
            android:layout_height="370dp"
            android:layout_marginBottom="32dp"
            android:padding="20dp"
            android:gravity="center">

            <!-- Color Wheel Arc Control -->
            <com.smarthome.iot.ui.views.ColorWheelView
                android:id="@+id/colorWheelView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- Light Bulb Image in Center (Dark Circle Background) -->
            <androidx.cardview.widget.CardView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                app:cardCornerRadius="90dp"
                app:cardBackgroundColor="@color/dark_4"
                app:cardElevation="0dp"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/imageViewLightBulbColor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/lamp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Light bulb"
                    android:tint="@color/white" />

            </androidx.cardview.widget.CardView>

        </FrameLayout>

    </LinearLayout>

    <!-- Brightness Control -->
    <LinearLayout
        android:id="@+id/brightnessControlContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_sun"
            android:tint="@color/orange"
            android:layout_marginEnd="12dp" />

        <SeekBar
            android:id="@+id/seekBarBrightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="85"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb"
            android:splitTrack="false"
            android:minHeight="16dp"
            android:maxHeight="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <TextView
            android:id="@+id/textViewBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85%"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/urbanist"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:minWidth="40dp"
            android:gravity="end" />

    </LinearLayout>

    <!-- Saturation/Warmth Control (Second Slider) -->
    <LinearLayout
        android:id="@+id/saturationControlContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_moon"
            android:tint="@color/white"
            android:layout_marginEnd="12dp" />

        <SeekBar
            android:id="@+id/seekBarSaturation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="64"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb"
            android:splitTrack="false"
            android:minHeight="16dp"
            android:maxHeight="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <TextView
            android:id="@+id/textViewSaturation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="64%"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/urbanist"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:minWidth="40dp"
            android:gravity="end" />

    </LinearLayout>

</LinearLayout>
