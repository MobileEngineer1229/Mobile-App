<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_1">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/left_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/device_detected"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/urbanist"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/buttonMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_scan"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Custom Tab Buttons -->
    <LinearLayout
        android:id="@+id/tabButtonsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="@drawable/tab_container_background_new">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonNearbyDevices"
                style="@style/Widget.SmartHome.TabButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:background="@drawable/tab_selected_background"
                android:textAppearance="@style/TextAppearance.Urbanist.Large.Bold"
                android:text="@string/nearby_devices"
                android:textColor="@color/white"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAddManual"
                style="@style/Widget.SmartHome.TabButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:background="@drawable/tab_unselected_background"
                android:textAppearance="@style/TextAppearance.Urbanist.Large.Bold"
                android:text="@string/add_manual"
                android:textColor="@color/white"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tabButtonsContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Connect to device Heading -->
            <TextView
                android:id="@+id/textViewConnectToDevice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/connect_to_device"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="36dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Wi-Fi & Bluetooth Container -->
            <LinearLayout
                android:id="@+id/wifiBluetoothContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/wifi_bluetooth_container"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/textViewConnectToDevice"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Wi-Fi Icon with Circular Background -->
                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/icon_circle_background" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wifi"
                        android:contentDescription="Wi-Fi"
                        app:tint="@color/white" />
                </FrameLayout>

                <!-- Bluetooth Icon with Circular Background -->
                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp">
                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/icon_circle_background" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bluetooth"
                        android:contentDescription="Bluetooth"
                        app:tint="@color/white" />
                </FrameLayout>

                <!-- Instruction Text -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/turn_on_wifi_bluetooth"
                    android:textSize="14sp"
                    android:fontFamily="@font/urbanist"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="none" />

            </LinearLayout>

            <!-- Device Selection with Checkbox -->
            <LinearLayout
                android:id="@+id/deviceSelection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="28dp"
                app:layout_constraintTop_toBottomOf="@id/wifiBluetoothContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/checkBoxDevice"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/checkmark_circle_blue"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/textViewDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Lamp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/urbanist"
                    android:textColor="@color/white" />

            </LinearLayout>

            <!-- Device Image -->
            <ImageView
                android:id="@+id/imageViewDevice"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="Device"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_marginTop="32dp"
                android:maxWidth="340dp"
                android:maxHeight="340dp"
                app:layout_constraintTop_toBottomOf="@id/deviceSelection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.85"
                app:layout_constraintDimensionRatio="1:1" />

            <!-- Progress Indicator Container (hidden by default) -->
            <LinearLayout
                android:id="@+id/progressContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/wifiBluetoothContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/textViewLearnMore">

                <!-- Device Name (shown during connecting) -->
                <LinearLayout
                    android:id="@+id/deviceSelectionProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="28dp">

                    <ImageView
                        android:id="@+id/checkBoxDeviceProgress"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/checkmark_circle_blue"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/textViewDeviceNameProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smart Lamp"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/urbanist"
                        android:textColor="@color/white" />

                </LinearLayout>

                <!-- "Can't connect" text above progress (shown during connecting) -->
                <TextView
                    android:id="@+id/textViewCantConnectProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cant_connect_question"
                    android:textSize="16sp"
                    android:fontFamily="@font/urbanist"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <!-- Progress Bar with Device Image -->
                <FrameLayout
                    android:layout_width="320dp"
                    android:layout_height="320dp"
                    android:layout_gravity="center">

                    <!-- Circular Progress Ring -->
                    <com.smarthome.iot.ui.views.CircularProgressView
                        android:id="@+id/progressBar"
                        android:layout_width="320dp"
                        android:layout_height="320dp"
                        android:layout_gravity="center" />

                    <!-- Device Image in Center -->
                    <ImageView
                        android:id="@+id/imageViewDeviceProgress"
                        android:layout_width="300dp"
                        android:layout_height="300dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_camera"
                        android:contentDescription="Device"
                        android:scaleType="fitCenter" />

                </FrameLayout>

                <!-- Progress Text Below Circle -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/textViewConnectingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connecting…"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:fontFamily="@font/urbanist"
                        />

                    <TextView
                        android:id="@+id/textViewProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/primary"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/urbanist"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Connect Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonConnect"
                android:layout_width="200dp"
                android:layout_height="72dp"
                android:text="@string/connect"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/urbanist"
                android:backgroundTint="@color/primary"
                app:cornerRadius="100dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginTop="36dp"
                app:layout_constraintTop_toBottomOf="@id/imageViewDevice"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Can't connect text - below Connect button -->
            <TextView
                android:id="@+id/textViewCantConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cant_connect_question"
                android:textSize="16sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/buttonConnect"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Learn More link - below Can't connect text -->
            <TextView
                android:id="@+id/textViewLearnMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learn more"
                android:textSize="16sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/textViewCantConnect"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
