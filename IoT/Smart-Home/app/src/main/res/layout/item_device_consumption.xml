<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/dark_4">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Arrow icon at top-right -->
        <ImageView
            android:id="@+id/imageViewArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:src="@drawable/ic_arrow_forward"
            android:tint="@color/white"
            android:alpha="0.7"
            android:contentDescription="Arrow"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp" />

        <!-- Main content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Icon and kWh/Cost row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <!-- Icon at top-left -->
                <ImageView
                    android:id="@+id/imageViewDeviceIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_smart"
                    android:tint="@color/white"
                    android:contentDescription="Device icon" />

                <!-- kWh and Cost -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="32dp">

                    <!-- kWh Value (large, bold) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/textViewConsumption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="184.69"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/urbanist"
                            android:textColor="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" kWh"
                            android:textSize="12sp"
                            android:fontFamily="@font/urbanist"
                            android:textColor="@color/white"
                            android:alpha="0.7" />

                    </LinearLayout>

                    <!-- Cost -->
                    <TextView
                        android:id="@+id/textViewCost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$27.70"
                        android:textSize="14sp"
                        android:fontFamily="@font/urbanist"
                        android:textColor="@color/white"
                        android:alpha="0.7"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Device Name -->
            <TextView
                android:id="@+id/textViewDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Lamp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:layout_marginTop="12dp" />

            <!-- Device Count -->
            <TextView
                android:id="@+id/textViewDeviceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 devices"
                android:textSize="13sp"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:alpha="0.7"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>

