<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="60dp"
    android:background="@color/dark_1">

    <!-- Category Filters (Horizontal Scrollable) -->
    <HorizontalScrollView
        android:id="@+id/categoryScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:id="@+id/categoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Popular Button -->
            <TextView
                android:id="@+id/buttonPopular"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/popular"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:background="@drawable/category_button_selected"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Lightning Button -->
            <TextView
                android:id="@+id/buttonLightning"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/lightning"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:background="@drawable/category_button_unselected"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Camera Button -->
            <TextView
                android:id="@+id/buttonCamera"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/camera"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:background="@drawable/category_button_unselected"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Electronics Button -->
            <TextView
                android:id="@+id/buttonElectronics"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/electronics"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/urbanist"
                android:textColor="@color/white"
                android:background="@drawable/category_button_unselected"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Device Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:nestedScrollingEnabled="true"
        android:clipToPadding="false"
        android:paddingTop="8dp" />

</LinearLayout>
