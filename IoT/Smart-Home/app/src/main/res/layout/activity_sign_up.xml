<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_1">

    <!-- Dark Header Bar -->
    <View
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dark_1"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Back Button in Header Bar -->
    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_arrow_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:tint="@color/white"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/headerBar"
        app:layout_constraintBottom_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Title with Icon -->
    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/join_smartify_today"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/urbanist" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:tint="@color/primary"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="Person icon" />

    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/textViewSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/join_smartify_subtitle"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:fontFamily="@font/urbanist"
        android:alpha="0.7"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/titleContainer"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/textViewSubtitle"
        app:layout_constraintBottom_toTopOf="@id/buttonSignUp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Email Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="@font/urbanist"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/emailInputContainer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/sign_in_input_background"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_envelope"
                    android:tint="@color/white"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/white"
                    android:textColorHint="#9E9E9E"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/urbanist"
                    android:background="@android:color/transparent"
                    android:padding="0dp" />

            </LinearLayout>

            <!-- Email Alert Message -->
            <include
                android:id="@+id/emailAlertMessage"
                layout="@layout/item_alert_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- Password Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/password"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="@font/urbanist"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/passwordInputContainer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/sign_in_input_background"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/white"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:textColor="@color/white"
                    android:textColorHint="#9E9E9E"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/urbanist"
                    android:background="@android:color/transparent"
                    android:padding="0dp" />

                <ImageButton
                    android:id="@+id/buttonTogglePassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_eye_off"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/password"
                    android:tint="#9E9E9E" />

            </LinearLayout>

            <!-- Password Alert Message -->
            <include
                android:id="@+id/passwordAlertMessage"
                layout="@layout/item_alert_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <!-- Terms & Conditions Checkbox -->
            <CheckBox
                android:id="@+id/checkBoxTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/i_agree_terms"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:letterSpacing="0.01"
                android:fontFamily="@font/urbanist"
                android:buttonTint="@color/primary"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:minHeight="0dp"
                android:layout_marginBottom="16dp" />

            <!-- Already have account link -->
            <TextView
                android:id="@+id/textViewSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_have_account"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:letterSpacing="0.01"
                android:fontFamily="@font/urbanist"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sign Up Button (Fixed at Bottom) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSignUp"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="@string/sign_up"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"
        app:cornerRadius="100dp"
        android:fontFamily="@font/urbanist"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/Widget.MaterialComponents.Button" />

    <!-- Loading Overlay -->
    <include
        android:id="@+id/loadingOverlay"
        layout="@layout/component_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
