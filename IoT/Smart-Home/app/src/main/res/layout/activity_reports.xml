<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_3"
    tools:context=".ui.ReportsActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="70dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textViewMyHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_home"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/urbanist"
                        android:textColor="@color/white" />

                    <ImageButton
                        android:id="@+id/buttonDropdown"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/my_home"
                        app:tint="@color/white" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/buttonCalendar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:src="@android:drawable/ic_menu_today"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Calendar"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/buttonMenu"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_more_vert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    app:tint="@color/white" />

            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Monthly Usage Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- This Month Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/dark_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <!-- Orange Icon -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp">

                            <View
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_circle_orange" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lightning"
                                android:contentDescription="Lightning icon"
                                app:tint="@android:color/white" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="This month"
                                android:textSize="12sp"
                                android:fontFamily="@font/urbanist"
                                android:textColor="@color/white"
                                android:alpha="0.7" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="2dp">

                                <TextView
                                    android:id="@+id/textViewThisMonthKwh"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="825.40"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/urbanist"
                                    android:textColor="@color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" kWh"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/urbanist"
                                    android:textColor="@color/white"
                                    android:alpha="0.7" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/textViewThisMonthCost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$123.81"
                                android:textSize="14sp"
                                android:fontFamily="@font/urbanist"
                                android:textColor="@color/white"
                                android:alpha="0.7"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Previous Month Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/dark_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <!-- Blue Icon -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp">

                            <View
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_circle_blue" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_plug"
                                android:contentDescription="Plug icon"
                                app:tint="@android:color/white" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Previous month"
                                android:textSize="12sp"
                                android:fontFamily="@font/urbanist"
                                android:textColor="@color/white"
                                android:alpha="0.7" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="2dp">

                                <TextView
                                    android:id="@+id/textViewPreviousMonthKwh"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="958.75"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/urbanist"
                                    android:textColor="@color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" kWh"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/urbanist"
                                    android:textColor="@color/white"
                                    android:alpha="0.7" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/textViewPreviousMonthCost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$143.81"
                                android:textSize="14sp"
                                android:fontFamily="@font/urbanist"
                                android:textColor="@color/white"
                                android:alpha="0.7"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Statistics Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_section_rounded"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/urbanist"
                        android:text="Statistics"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewDateRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_dark"
                        android:drawableEnd="@drawable/ic_chevron_down"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/white"
                        android:fontFamily="@font/urbanist"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="Last 6 Months"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Divider Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/dark_5" />

                <!-- Statistics Chart -->
                <com.smarthome.iot.ui.views.BarChartView
                    android:id="@+id/barChartView"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginBottom="0dp"
                    android:background="@android:color/transparent" />

            </LinearLayout>

            <!-- Devices Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section_rounded"
                android:orientation="vertical"
                android:layout_marginStart="-24dp"
                android:layout_marginEnd="-24dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- Devices Section Title - Inside background -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Devices"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/urbanist"
                        android:textColor="@color/white" />

                    <ImageButton
                        android:id="@+id/buttonDevicesMenu"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_more_vert"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Devices Menu"
                        android:tint="@color/white" />

                </LinearLayout>

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/emptyStateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No consumption data available"
                        android:textSize="16sp"
                        android:fontFamily="@font/urbanist"
                        android:textColor="@color/white"
                        android:alpha="0.7" />

                </LinearLayout>

                <!-- Devices Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@color/dark_3"
        style="@style/CustomBottomNavigationView"
        app:itemIconTint="@null"
        app:itemTextColor="@color/nav_item_color_selector"
        app:itemBackground="@drawable/bottom_nav_item_background"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="24dp"
        app:itemTextAppearanceActive="@style/BottomNavTextStyleActive"
        app:itemTextAppearanceInactive="@style/BottomNavTextStyle"
        app:menu="@menu/bottom_navigation" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

