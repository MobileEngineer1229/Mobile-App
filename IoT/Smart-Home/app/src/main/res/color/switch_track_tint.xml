<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked (ON) state: Blue primary color -->
    <item android:color="@color/primary" android:state_checked="true" />
    <!-- Unchecked (OFF) state: Dark gray -->
    <item android:color="@color/dark_4" android:state_checked="false" />
    <!-- Default: Dark gray -->
    <item android:color="@color/dark_4" />
</selector>
