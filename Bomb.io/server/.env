# Local development environment

# MongoDB — no auth (local install)
MONGO_URI=mongodb://localhost:27017/bombio

# Redis — local
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=local-dev-secret-change-in-prod

# Service ports
PORT_LOGIN=8000
PORT_MATCH=8001
PORT_RANK=8002
UDP_PORT=5000

# Battle room
ROOM_ID=dev-room
MAP_ID=dev
