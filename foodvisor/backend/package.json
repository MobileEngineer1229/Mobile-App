{
  "name": "foodvisor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-dist.mjs && tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:images": "tsx src/scripts/migrate.ts --download-images",
    "download:food-images": "tsx src/scripts/download-food-images.ts",
    "download:real-food-images": "tsx src/scripts/download-real-food-images.ts",
    "remove:generated-food-images": "tsx src/scripts/remove-generated-food-images.ts",
    "import:food-material": "tsx src/scripts/import-food-material.ts",
    "import:china-food-composition": "tsx src/scripts/import-china-food-composition.ts",
    "import:food-composition-u2": "tsx src/scripts/import-food-composition-u2.ts",
    "import:foodyou-swiss": "tsx src/scripts/import-foodyou-swiss-food-composition.ts",
    "import:lp-diet-sr28": "tsx src/scripts/import-lp-diet-sr28.ts",
    "import:opennutritracker-activities": "tsx src/scripts/import-opennutritracker-activities.ts",
    "import:human-type-qa": "tsx src/scripts/import-human-type-qa.ts",
    "import:reference-guidelines": "tsx src/scripts/import-reference-guidelines.ts",
    "generate:daily-value-profiles": "tsx src/scripts/generate-daily-value-profiles.ts",
    "import:comprehensive": "tsx src/scripts/import-comprehensive-food-database.ts",
    "import:usda": "tsx src/scripts/import-usda-foods.ts",
    "backfill:data-sources": "tsx src/scripts/backfill-data-sources.ts",
    "verify:data-sources": "tsx src/scripts/verify-data-sources.ts",
    "normalize:food-names": "tsx src/scripts/normalize-food-names.ts",
    "translate:food-names:deepseek": "tsx src/scripts/translate-food-names-deepseek.ts",
    "import:korean-names": "tsx src/scripts/import-korean-names-from-reference.ts",
    "verify:nutrients": "tsx src/scripts/verify-nutrient-data.ts",
    "seed": "tsx src/scripts/migrate.ts --download-images"
