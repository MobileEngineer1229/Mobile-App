<?xml version="1.0" encoding="utf-8"?>
<!-- Custom input field with teal left border accent -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/goal_unselected_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:right="0dp" android:top="0dp" android:bottom="0dp" android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:topLeftRadius="12dp" android:bottomLeftRadius="12dp" />
        </shape>
    </item>
</layer-list>
