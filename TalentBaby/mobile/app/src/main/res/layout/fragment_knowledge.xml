<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDF6EE">

    <!-- ══ HEADER: blush→peach gradient + wave overlay ══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Gradient content area -->
        <LinearLayout
            android:id="@+id/headerLibrary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_library_header"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="46dp">

            <!-- Top row: menu ← → Parenting Support -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnMenuLibrary"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_menu_hamburger"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:padding="8dp"
                    android:tint="#2B1F1A" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <!-- Coral pill: text + white circle with chat icon -->
                <!-- Using MaterialButton for reliable coral background -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnParentingSupportLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/parenting_support"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    app:backgroundTint="#F08B6B"
                    app:cornerRadius="100dp"
                    app:icon="@drawable/ic_chat_white"
                    app:iconGravity="end"
                    app:iconSize="14dp"
                    app:iconTint="#F08B6B"
                    app:iconPadding="8dp"
                    app:strokeWidth="0dp"
                    style="@style/Widget.MaterialComponents.Button"
                    android:elevation="4dp" />
            </LinearLayout>

            <!-- Title block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☁️"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/library_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#2B1F1A"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/library_subtitle"
                    android:textSize="13sp"
                    android:textColor="#5C4A42"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Decorative cloud: right-bottom, alpha=0.4 -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_cloud_deco"
            android:alpha="0.4"
            android:scaleType="fitXY"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-8dp"
            android:layout_marginBottom="28dp"
            android:contentDescription="" />

        <!-- Wave curve: cream path covering the gradient bottom, height=30dp -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:src="@drawable/ic_wave_cream"
            android:scaleType="fitXY"
            android:layout_gravity="bottom"
            android:contentDescription="" />

    </FrameLayout>

    <!-- ══ SCROLLABLE CARDS: cream background ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FDF6EE"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <!-- ── Wisdom & Insights — full width, 180dp tile ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWisdom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="180dp">

                        <View
                            android:id="@+id/tileSky"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/library_wisdom"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#2B1F1A"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="14dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── 2-column: Nutrition & Recipes  |  Story Time ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:baselineAligned="false">

                <!-- Nutrition & Recipes — mustard tile -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardNutrition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp">

                            <View
                                android:id="@+id/tileMustard"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/library_nutrition"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#2B1F1A"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Story Time — plum tile -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp">

                            <View
                                android:id="@+id/tilePlum"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text=""
                                android:fontFamily="monospace"
                                android:textSize="9sp"
                                android:textColor="#5C4A42"
                                android:alpha="0.6"
                                android:gravity="center"
                                android:padding="6dp" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/library_stories"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#2B1F1A"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- ── Growth Tracker — full width, sage tile ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGrowthTracker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp">

                        <View
                            android:id="@+id/tileSage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text=""
                            android:fontFamily="monospace"
                            android:textSize="9sp"
                            android:textColor="#5C4A42"
                            android:alpha="0.6"
                            android:gravity="center"
                            android:padding="6dp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/library_growth_tracker"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#2B1F1A"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="14dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
