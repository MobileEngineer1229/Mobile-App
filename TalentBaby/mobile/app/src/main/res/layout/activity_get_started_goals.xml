<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_design">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="190dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="58dp"
        android:paddingTop="390dp"
        android:paddingEnd="58dp"
        android:paddingBottom="52dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/goals_title"
            android:textColor="@color/design_blue"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/goals_subtitle"
            android:textColor="@color/design_blue"
            android:textSize="22sp" />

        <LinearLayout
            android:id="@+id/goalActivities"
            style="@style/GetStartedGoalRow"
            android:layout_marginTop="88dp">
            <ImageView android:id="@+id/iconGoal1" style="@style/GetStartedGoalIcon" android:src="@drawable/ic_goal_blocks" app:tint="@color/design_gray" />
            <TextView android:id="@+id/textGoal1" style="@style/GetStartedGoalText" android:text="@string/goal_1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/goalMilestones"
            style="@style/GetStartedGoalRow">
            <ImageView android:id="@+id/iconGoal2" style="@style/GetStartedGoalIcon" android:src="@drawable/ic_goal_milestone" app:tint="@color/design_gray" />
            <TextView android:id="@+id/textGoal2" style="@style/GetStartedGoalText" android:text="@string/goal_2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/goalStories"
            style="@style/GetStartedGoalRow">
            <ImageView android:id="@+id/iconGoal3" style="@style/GetStartedGoalIcon" android:src="@drawable/ic_goal_stories" app:tint="@color/design_gray" />
            <TextView android:id="@+id/textGoal3" style="@style/GetStartedGoalText" android:text="@string/goal_3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/goalNutrition"
            style="@style/GetStartedGoalRow">
            <ImageView android:id="@+id/iconGoal4" style="@style/GetStartedGoalIcon" android:src="@drawable/ic_goal_nutrition" app:tint="@color/design_gray" />
            <TextView android:id="@+id/textGoal4" style="@style/GetStartedGoalText" android:text="@string/goal_4" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/goalSleep"
            style="@style/GetStartedGoalRow">
            <ImageView android:id="@+id/iconGoal5" style="@style/GetStartedGoalIcon" android:src="@drawable/ic_goal_tracker" app:tint="@color/design_gray" />
            <TextView android:id="@+id/textGoal5" style="@style/GetStartedGoalText" android:text="@string/goal_5" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@drawable/bg_disabled_pill"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/continue_btn"
            android:textColor="@color/design_gray"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>
