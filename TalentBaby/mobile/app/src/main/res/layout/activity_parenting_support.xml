<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="260dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_header"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="116dp"
            android:paddingEnd="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBackSupport"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/black" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:text="@string/support_title"
                    android:textColor="@color/home_text_dark"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/circle_support_teal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription=""
                        android:src="@drawable/ic_chat_white" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_gravity="bottom"
            android:contentDescription=""
            android:scaleType="fitXY"
            android:src="@drawable/bg_activity_header_curve" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/support_subtitle"
                android:textColor="@color/home_text_dark"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/support_common_topics"
                android:textColor="@color/home_text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/topicSleep"
                    style="@style/SupportTopic"
                    android:text="@string/support_topic_sleep" />

                <TextView
                    android:id="@+id/topicFeeding"
                    style="@style/SupportTopic"
                    android:text="@string/support_topic_feeding" />

                <TextView
                    android:id="@+id/topicMilestones"
                    style="@style/SupportTopic"
                    android:text="@string/support_topic_milestones" />

                <TextView
                    android:id="@+id/topicGrowth"
                    style="@style/SupportTopic"
                    android:text="@string/support_topic_growth" />
            </LinearLayout>

            <EditText
                android:id="@+id/editSupportMessage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_soft_input"
                android:gravity="top|start"
                android:hint="@string/support_message_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                android:padding="20dp"
                android:textColor="@color/home_text_dark"
                android:textColorHint="@color/home_text_muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnSendSupport"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_teal_button_large"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/support_send"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
