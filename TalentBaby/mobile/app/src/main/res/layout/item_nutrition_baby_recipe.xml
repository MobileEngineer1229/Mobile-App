<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="127dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/imageRecipeDisplay"
            android:layout_width="102dp"
            android:layout_height="102dp"
            android:background="@drawable/bg_nutrition_image_soft"
            android:contentDescription="@string/recipes_for_baby"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/textRecipeDisplayTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_weight="1"
            android:textColor="@color/home_text_dark"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/actionsRecipeDisplay"
            android:layout_width="74dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription=""
                android:src="@drawable/ic_bookmark_outline" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:contentDescription=""
                android:src="@drawable/ic_share_outline_teal" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/lockRecipeDisplay"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_nutrition_premium_lock"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription=""
                android:src="@drawable/ic_activity_lock" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
