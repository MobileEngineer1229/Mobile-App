<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/bg_home_header"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="88dp"
        android:paddingEnd="26dp">

        <ImageButton
            android:id="@+id/btnBackBabyProfile"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:gravity="center"
            android:text="@string/personalise_baby_plan_title"
            android:textColor="@color/home_text_dark"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="242dp"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_baby_profile_panel"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="92dp"
            android:paddingEnd="22dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:id="@+id/layoutBabyNameSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_teal_outline_pill"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/tabBabyGirl"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_teal_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/girl"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabBabyBoy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/boy"
                        android:textColor="@color/article_header"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/BabyProfileLabel"
                    android:layout_marginTop="40dp"
                    android:text="@string/baby_first_name" />

                <EditText
                    android:id="@+id/editProfileBabyName"
                    style="@style/BabyProfileInput"
                    android:inputType="textPersonName" />
            </LinearLayout>

            <TextView
                style="@style/BabyProfileLabel"
                android:layout_marginTop="32dp"
                android:text="@string/baby_dob" />

            <LinearLayout
                android:id="@+id/layoutProfileDob"
                android:layout_width="260dp"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_soft_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_calendar_outline"
                    android:tint="@color/article_header" />

                <TextView
                    android:id="@+id/textProfileDob"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:textSize="20sp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription=""
                    android:src="@drawable/ic_chevron_down_gray" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/is_premature"
                    android:textColor="@color/home_text_dark"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/switchPremature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/BabyProfileLabel"
                android:layout_marginTop="34dp"
                android:text="@string/i_am_childs" />

            <TextView
                android:id="@+id/textProfileRelationship"
                style="@style/BabyProfilePicker"
                android:layout_marginTop="12dp"
                android:drawableEnd="@drawable/ic_chevron_down_gray"
                android:text="@string/rel_mother" />

            <TextView
                style="@style/BabyProfileLabel"
                android:layout_marginTop="30dp"
                android:text="@string/country" />

            <TextView
                android:id="@+id/textProfileCountry"
                style="@style/BabyProfilePicker"
                android:layout_marginTop="12dp"
                android:drawableEnd="@drawable/ic_chevron_down_gray"
                android:text="@string/united_states" />

            <TextView
                style="@style/BabyProfileLabel"
                android:layout_marginTop="30dp"
                android:text="@string/your_name" />

            <EditText
                android:id="@+id/editProfileParentName"
                style="@style/BabyProfileInput"
                android:inputType="textPersonName" />

            <TextView
                android:id="@+id/btnUpdateBabyProfile"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_teal_button_large"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/update"
                android:textColor="@color/white"
                android:textSize="21sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="218dp"
        android:background="@drawable/circle_white_solid">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center"
            android:contentDescription="@string/baby_name"
            android:src="@drawable/ic_baby_face_blue" />
    </FrameLayout>
</FrameLayout>
