<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_header"
    android:clipChildren="false">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="200dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/check_milestone_progress"
                        android:textColor="@color/article_header"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textMilestoneInfo"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_info_circle_teal"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="i"
                        android:textColor="@color/article_header"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textMilestoneSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/milestone_progress_subtitle"
                    android:textSize="14sp"
                    android:textColor="@color/home_text_muted"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.25"
                    android:layout_marginTop="5dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarMilestones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/article_header"
                android:paddingTop="16dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMilestones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <LinearLayout
                android:id="@+id/layoutMilestonesEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                    android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:textSize="40sp"
                    android:textColor="@color/article_header" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_milestones"
                    android:textSize="16sp"
                    android:textColor="@color/home_text_muted"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnCreateReport"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_teal_button_large"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/create_report"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarMilestones"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="@drawable/bg_home_header"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:translationZ="0dp"
        app:elevation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="top"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageButton
                    android:id="@+id/btnMenuMilestones"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu_hamburger"
                    android:tint="@color/home_text_dark" />

                <FrameLayout
                    android:id="@+id/btnParentingSupportMs"
                    android:layout_width="170dp"
                    android:layout_height="46dp"
                    android:layout_gravity="end|center_vertical"
                    android:clickable="true"
                    android:elevation="34dp"
                    android:focusable="true">

                    <TextView
                        android:layout_width="145dp"
                        android:layout_height="29dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_support_label"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="30dp"
                        android:text="@string/parenting_support"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="43dp"
                        android:layout_height="43dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/circle_support_teal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/parenting_support"
                            android:src="@drawable/ic_chat_white"
                            android:tint="@color/white" />
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>

            <HorizontalScrollView
                android:id="@+id/scrollMonthsMilestones"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_gravity="top"
                android:layout_marginTop="64dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutMonthPillsMilestones"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:contentDescription=""
                android:scaleType="fitXY"
                android:src="@drawable/bg_activity_header_curve" />
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>
</FrameLayout>
