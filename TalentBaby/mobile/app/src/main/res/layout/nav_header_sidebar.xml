<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="280dp"
    android:background="@drawable/bg_sidebar_header"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="68dp"
    android:paddingEnd="26dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:id="@+id/layoutSidebarBaby"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="78dp"
            android:layout_height="78dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_gravity="start|center_vertical"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="37dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/textAvatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="bc"
                    android:textColor="@color/design_blue"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="end|top"
                android:background="@drawable/circle_white_solid"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/home_teal"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/textBabyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_weight="1"
            android:text="bc"
            android:textColor="@color/home_text_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnEditActiveBaby"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit"
            android:padding="8dp"
            android:src="@drawable/ic_edit_white" />
    </LinearLayout>

    <TextView
        android:id="@+id/textAddBaby"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/sidebar_add_baby"
        android:textColor="#8CFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="Logged in as:"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textUserEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="user@email.com"
        android:textColor="@color/white"
        android:textSize="16sp" />
</LinearLayout>
