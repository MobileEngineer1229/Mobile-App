<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_milestone_section_header"
    android:layout_marginTop="16dp"
    android:paddingStart="26dp"
    android:paddingEnd="24dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/textSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <ImageView
        android:id="@+id/iconSectionChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_down_white"
        android:contentDescription="Expand section" />

</LinearLayout>
