model memories {
  id                     Int                @id @default(autoincrement())
  baby_id                Int
  memory_type            String             @db.VarChar(50)
  title                  String?            @db.VarChar(255)
  description            String?
  media_url              String?
  thumbnail_url          String?
  memory_date            DateTime           @db.Date
  tags                   String[]
  location               String?            @db.VarChar(255)
  created_at             DateTime?          @default(now()) @db.Timestamp(6)
  updated_at             DateTime?          @default(now()) @db.Timestamp(6)
  video_duration_seconds Int?
  video_file_size_bytes  BigInt?
  video_format           String?            @db.VarChar(20)
  video_resolution       String?            @db.VarChar(20)
  activity_videos        activity_videos[]
  babies                 babies             @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  milestone_videos       milestone_videos[]
  video_shares           video_shares[]
  video_tags             video_tags[]

  @@index([baby_id], map: "idx_memories_baby_id")
  @@index([memory_date], map: "idx_memories_memory_date")
}

model video_shares {
  id                Int       @id @default(autoincrement())
  memory_id         Int
  shared_by_user_id Int
  share_token       String    @unique @db.VarChar(255)
  share_type        String?   @default("link") @db.VarChar(50)
  expires_at        DateTime? @db.Timestamp(6)
  view_count        Int?      @default(0)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  memories          memories  @relation(fields: [memory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users     @relation(fields: [shared_by_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model video_tags {
  id         Int       @id @default(autoincrement())
  memory_id  Int
  tag_name   String    @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  memories   memories  @relation(fields: [memory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([memory_id, tag_name])
}
