model feedings {
  id               Int       @id @default(autoincrement())
  baby_id          Int
  feeding_type     String    @db.VarChar(50)
  feeding_date     DateTime  @db.Timestamp(6)
  start_time       DateTime? @db.Timestamp(6)
  end_time         DateTime? @db.Timestamp(6)
  duration_minutes Int?
  amount_ml        Decimal?  @db.Decimal(6, 2)
  amount_oz        Decimal?  @db.Decimal(6, 2)
  side             String?   @db.VarChar(20)
  notes            String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  babies           babies    @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([baby_id], map: "idx_feedings_baby_id")
  @@index([feeding_date], map: "idx_feedings_feeding_date")
}

model sleep_sessions {
  id               Int       @id @default(autoincrement())
  baby_id          Int
  sleep_type       String    @db.VarChar(50)
  start_time       DateTime  @db.Timestamp(6)
  end_time         DateTime? @db.Timestamp(6)
  duration_minutes Int?
  quality_rating   Int?
  notes            String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  babies           babies    @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([baby_id], map: "idx_sleep_sessions_baby_id")
  @@index([start_time], map: "idx_sleep_sessions_start_time")
}

model diaper_changes {
  id          Int       @id @default(autoincrement())
  baby_id     Int
  change_time DateTime  @db.Timestamp(6)
  diaper_type String    @db.VarChar(20)
  notes       String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  babies      babies    @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([baby_id], map: "idx_diaper_changes_baby_id")
  @@index([change_time], map: "idx_diaper_changes_change_time")
}
