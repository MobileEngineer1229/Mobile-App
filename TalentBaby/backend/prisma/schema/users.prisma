model users {
  id                                   Int                            @id @default(autoincrement())
  email                                String                         @unique @db.VarChar(255)
  password_hash                        String                         @db.VarChar(255)
  full_name                            String?                        @db.VarChar(255)
  phone_number                         String?                        @db.VarChar(50)
  gender                               String?                        @db.VarChar(20)
  birthdate                            DateTime?                      @db.Date
  profile_picture_url                  String?
  language_preference                  String?                        @default("en") @db.VarChar(10)
  created_at                           DateTime?                      @default(now()) @db.Timestamp(6)
  updated_at                           DateTime?                      @default(now()) @db.Timestamp(6)
  role                                 String?                        @default("user") @db.VarChar(20)
  active_baby_id                       Int?
  is_premium                           Boolean?                       @default(false)
  relation_to_baby                     String?                        @db.VarChar(50)
  appointments                         appointments[]
  article_bookmarks                    article_bookmarks[]
  article_reading_history              article_reading_history[]
  babies_babies_user_idTousers         babies[]                       @relation("babies_user_idTousers")
  birth_club_memberships               birth_club_memberships[]
  birth_plans                          birth_plans[]
  checklists                           checklists[]
  class_enrollments                    class_enrollments[]
  community_posts                      community_posts[]
  daily_calorie_summary                daily_calorie_summary[]
  daily_meal_plans                     daily_meal_plans[]
  doctor_profiles                      doctor_profiles?
  family_members                       family_members[]
  food_intake_logs                     food_intake_logs[]
  messages_messages_receiver_idTousers messages[]                     @relation("messages_receiver_idTousers")
  messages_messages_sender_idTousers   messages[]                     @relation("messages_sender_idTousers")
  post_comments                        post_comments[]
  post_likes                           post_likes[]
  pregnancies                          pregnancies[]
  recipe_favorites                     recipe_favorites[]
  registries                           registries[]
  reminders                            reminders[]
  story_favorites                      story_favorites[]
  subscriptions                        subscriptions[]
  user_action_logs                     user_action_logs[]
  user_article_comment_likes           user_article_comment_likes[]
  user_article_comments                user_article_comments[]
  user_article_likes                   user_article_likes[]
  user_articles                        user_articles[]
  user_notification_preferences        user_notification_preferences?
  user_point_history                   user_point_history[]
  user_points                          user_points?
  babies_users_active_baby_idTobabies  babies?                        @relation("users_active_baby_idTobabies", fields: [active_baby_id], references: [id], onUpdate: NoAction)
  video_shares                         video_shares[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model doctor_profiles {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  specialty      String    @db.VarChar(100)
  license_number String?   @db.VarChar(100)
  hospital       String?   @db.VarChar(255)
  grade          String    @default("intern") @db.VarChar(50)
  grade_level    Int?      @default(1)
  bio            String?
  verified       Boolean?  @default(false)
  verified_at    DateTime? @db.Timestamp(6)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([grade_level], map: "idx_doctor_profiles_grade_level")
}

model user_notification_preferences {
  id                           Int       @id @default(autoincrement())
  user_id                      Int       @unique
  growth_milestone_alerts      Boolean?  @default(true)
  vaccination_reminders        Boolean?  @default(true)
  development_milestone_alerts Boolean?  @default(true)
  health_check_reminders       Boolean?  @default(true)
  photo_memories               Boolean?  @default(true)
  app_updates                  Boolean?  @default(true)
  created_at                   DateTime? @default(now()) @db.Timestamp(6)
  updated_at                   DateTime? @default(now()) @db.Timestamp(6)
  users                        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_point_history {
  id             Int       @id @default(autoincrement())
  user_id        Int
  points         Int
  reason         String    @db.VarChar(100)
  reference_id   Int?
  reference_type String?   @db.VarChar(50)
  description    String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_user_point_history_user_id")
}

model user_points {
  id           Int       @id @default(autoincrement())
  user_id      Int       @unique
  total_points Int?      @default(0)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
