  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model talent_assessments {
  id                 Int                  @id @default(autoincrement())
  baby_id            Int
  talent_category_id Int
  assessment_date    DateTime             @db.Date
  age_in_months      Int
  score              Int?
  observations       String?
  recommendations    String?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  assessment_answers assessment_answers[]
  babies             babies               @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  talent_categories  talent_categories    @relation(fields: [talent_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([baby_id], map: "idx_talent_assessments_baby_id")
}

model talent_categories {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique @db.VarChar(100)
  description          String?
  icon_url             String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  ai_insights          ai_insights[]
  assessment_questions assessment_questions[]
  talent_assessments   talent_assessments[]
  talent_missions      talent_missions[]
  talent_progress      talent_progress[]
}

model talent_missions {
  id                     Int               @id @default(autoincrement())
  baby_id                Int
  talent_category_id     Int
  mission_title          String            @db.VarChar(255)
  mission_description    String?
  suggested_activities   Int[]
  start_date             DateTime          @db.Date
  target_completion_date DateTime?         @db.Date
  completed_date         DateTime?         @db.Date
  status                 String?           @default("pending") @db.VarChar(20)
  created_at             DateTime?         @default(now()) @db.Timestamp(6)
  updated_at             DateTime?         @default(now()) @db.Timestamp(6)
  babies                 babies            @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  talent_categories      talent_categories @relation(fields: [talent_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model talent_progress {
  id                  Int               @id @default(autoincrement())
  baby_id             Int
  talent_category_id  Int
  current_level       String?           @db.VarChar(50)
  progress_percentage Int?              @default(0)
  last_activity_date  DateTime?         @db.Date
  badges_earned       String[]
  created_at          DateTime?         @default(now()) @db.Timestamp(6)
  updated_at          DateTime?         @default(now()) @db.Timestamp(6)
  babies              babies            @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  talent_categories   talent_categories @relation(fields: [talent_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([baby_id, talent_category_id])
  @@index([baby_id], map: "idx_talent_progress_baby_id")
}

model user_action_logs {
  id                 Int       @id @default(autoincrement())
  user_id            Int?
  action_type        String    @db.VarChar(100)
  action_description String?
  resource_type      String?   @db.VarChar(50)
  resource_id        Int?
  ip_address         String?   @db.VarChar(45)
  user_agent         String?
  request_method     String?   @db.VarChar(10)
  request_path       String?   @db.VarChar(255)
  status_code        Int?
  error_message      String?
  metadata           Json?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  users              users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([action_type], map: "idx_user_action_logs_action_type")
  @@index([created_at], map: "idx_user_action_logs_created_at")
  @@index([resource_type, resource_id], map: "idx_user_action_logs_resource")
  @@index([user_id], map: "idx_user_action_logs_user_id")
}

model user_article_comment_likes {
  id                    Int                   @id @default(autoincrement())
  comment_id            Int
  user_id               Int
  created_at            DateTime?             @default(now()) @db.Timestamp(6)
  user_article_comments user_article_comments @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([comment_id, user_id])
}

model user_article_comments {
  id                          Int                          @id @default(autoincrement())
  article_id                  Int
  user_id                     Int
  parent_id                   Int?
  content                     String
  like_count                  Int?                         @default(0)
  is_doctor_comment           Boolean?                     @default(false)
  created_at                  DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                    @default(now()) @db.Timestamp(6)
  user_article_comment_likes  user_article_comment_likes[]
  user_articles               user_articles                @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_article_comments       user_article_comments?       @relation("user_article_commentsTouser_article_comments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_user_article_comments user_article_comments[]      @relation("user_article_commentsTouser_article_comments")
  users                       users                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([article_id], map: "idx_user_article_comments_article_id")
  @@index([parent_id], map: "idx_user_article_comments_parent_id")
}

model user_article_likes {
  id            Int           @id @default(autoincrement())
  article_id    Int
  user_id       Int
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  user_articles user_articles @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([article_id, user_id])
}

model user_articles {
  id                    Int                     @id @default(autoincrement())
  user_id               Int
  title                 String                  @db.VarChar(500)
  content               String
  category              String?                 @default("general") @db.VarChar(100)
  tags                  String[]                @default([])
  thumbnail_url         String?
  status                String?                 @default("published") @db.VarChar(20)
  view_count            Int?                    @default(0)
  like_count            Int?                    @default(0)
  comment_count         Int?                    @default(0)
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  updated_at            DateTime?               @default(now()) @db.Timestamp(6)
  keywords              String[]                @default([])
  user_article_comments user_article_comments[]
  user_article_likes    user_article_likes[]
  users                 users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([category], map: "idx_user_articles_category")
  @@index([created_at(sort: Desc)], map: "idx_user_articles_created_at")
  @@index([keywords], map: "idx_user_articles_keywords", type: Gin)
  @@index([status], map: "idx_user_articles_status")
  @@index([user_id], map: "idx_user_articles_user_id")
}

model user_notification_preferences {
  id                           Int       @id @default(autoincrement())
  user_id                      Int       @unique
  growth_milestone_alerts      Boolean?  @default(true)
  vaccination_reminders        Boolean?  @default(true)
  development_milestone_alerts Boolean?  @default(true)
  health_check_reminders       Boolean?  @default(true)
  photo_memories               Boolean?  @default(true)
  app_updates                  Boolean?  @default(true)
  created_at                   DateTime? @default(now()) @db.Timestamp(6)
  updated_at                   DateTime? @default(now()) @db.Timestamp(6)
  users                        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_point_history {
  id             Int       @id @default(autoincrement())
  user_id        Int
  points         Int
  reason         String    @db.VarChar(100)
  reference_id   Int?
  reference_type String?   @db.VarChar(50)
  description    String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_user_point_history_user_id")
}

model user_points {
  id           Int       @id @default(autoincrement())
  user_id      Int       @unique
  total_points Int?      @default(0)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                   Int                            @id @default(autoincrement())
  email                                String                         @unique @db.VarChar(255)
  password_hash                        String                         @db.VarChar(255)
  full_name                            String?                        @db.VarChar(255)
  phone_number                         String?                        @db.VarChar(50)
  gender                               String?                        @db.VarChar(20)
  birthdate                            DateTime?                      @db.Date
  profile_picture_url                  String?
  language_preference                  String?                        @default("en") @db.VarChar(10)
  created_at                           DateTime?                      @default(now()) @db.Timestamp(6)
  updated_at                           DateTime?                      @default(now()) @db.Timestamp(6)
  role                                 String?                        @default("user") @db.VarChar(20)
  active_baby_id                       Int?
  is_premium                           Boolean?                       @default(false)
  relation_to_baby                     String?                        @db.VarChar(50)
  appointments                         appointments[]
  article_bookmarks                    article_bookmarks[]
  article_reading_history              article_reading_history[]
  babies_babies_user_idTousers         babies[]                       @relation("babies_user_idTousers")
  birth_club_memberships               birth_club_memberships[]
  birth_plans                          birth_plans[]
  checklists                           checklists[]
  class_enrollments                    class_enrollments[]
  community_posts                      community_posts[]
  daily_calorie_summary                daily_calorie_summary[]
  daily_meal_plans                     daily_meal_plans[]
  doctor_profiles                      doctor_profiles?
  family_members                       family_members[]
  food_intake_logs                     food_intake_logs[]
  messages_messages_receiver_idTousers messages[]                     @relation("messages_receiver_idTousers")
  messages_messages_sender_idTousers   messages[]                     @relation("messages_sender_idTousers")
  post_comments                        post_comments[]
  post_likes                           post_likes[]
  pregnancies                          pregnancies[]
  recipe_favorites                     recipe_favorites[]
  registries                           registries[]
  reminders                            reminders[]
  story_favorites                      story_favorites[]
  subscriptions                        subscriptions[]
  user_action_logs                     user_action_logs[]
  user_article_comment_likes           user_article_comment_likes[]
  user_article_comments                user_article_comments[]
  user_article_likes                   user_article_likes[]
  user_articles                        user_articles[]
  user_notification_preferences        user_notification_preferences?
  user_point_history                   user_point_history[]
  user_points                          user_points?
  babies_users_active_baby_idTobabies  babies?                        @relation("users_active_baby_idTobabies", fields: [active_baby_id], references: [id], onUpdate: NoAction)
  video_shares                         video_shares[]
}

model vaccinations {
  id                Int       @id @default(autoincrement())
  baby_id           Int
  vaccine_name      String    @db.VarChar(255)
  scheduled_date    DateTime  @db.Date
  administered_date DateTime? @db.Date
  dose_number       Int?
  notes             String?
  reminder_sent     Boolean?  @default(false)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  babies            babies    @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model video_shares {
  id                Int       @id @default(autoincrement())
  memory_id         Int
  shared_by_user_id Int
  share_token       String    @unique @db.VarChar(255)
  share_type        String?   @default("link") @db.VarChar(50)
  expires_at        DateTime? @db.Timestamp(6)
  view_count        Int?      @default(0)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  memories          memories  @relation(fields: [memory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users     @relation(fields: [shared_by_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model video_tags {
  id         Int       @id @default(autoincrement())
  memory_id  Int
  tag_name   String    @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  memories   memories  @relation(fields: [memory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([memory_id, tag_name])
}
