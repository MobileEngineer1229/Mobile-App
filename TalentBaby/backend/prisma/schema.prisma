generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activities {
  id                    Int                     @id @default(autoincrement())
  title                 String                  @db.VarChar(255)
  description           String?
  category              String?                 @db.VarChar(50)
  age_range_min_months  Int?
  age_range_max_months  Int?
  duration_minutes      Int?
  difficulty_level      String?                 @db.VarChar(20)
  materials_needed      String[]
  instructions          String?
  learning_outcomes     String[]
  image_url             String?
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  updated_at            DateTime?               @default(now()) @db.Timestamp(6)
  video_url             String?
  video_thumbnail_url   String?
  sub_category          String?                 @db.VarChar(100)
  benefits              String[]
  frequency             String?
  month_min             Int?                    @default(1)
  month_max             Int?                    @default(36)
  done_count            Int?                    @default(0)
  is_premium            Boolean?                @default(false)
  language              String                  @default("en") @db.Char(2)
  doctor_verified       Boolean                 @default(false)
  baby_activities       baby_activities[]
  baby_daily_activities baby_daily_activities[]

  @@unique([title, sub_category], map: "idx_activities_title_subcategory")
  @@index([age_range_min_months, age_range_max_months], map: "idx_activities_age_range")
  @@index([language], map: "idx_activities_lang")
  @@index([month_min, month_max], map: "idx_activities_month")
}

model activity_videos {
  id               Int             @id @default(autoincrement())
  baby_activity_id Int
  memory_id        Int
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  baby_activities  baby_activities @relation(fields: [baby_activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  memories         memories        @relation(fields: [memory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([baby_activity_id, memory_id])
}

model admin_messages {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(255)
  body         String
  type         String    @default("announcement") @db.VarChar(50)
  priority     String    @default("normal") @db.VarChar(20)
  target_role  String    @default("all") @db.VarChar(20)
  is_published Boolean   @default(false)
  published_at DateTime? @db.Timestamp(6)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @db.Timestamp(6)

  @@index([is_published, published_at(sort: Desc)], map: "idx_admin_messages_published")
  @@index([target_role], map: "idx_admin_messages_target_role")
}

model ai_insights {
  id                         Int                @id @default(autoincrement())
  baby_id                    Int
  insight_type               String?            @db.VarChar(50)
  title                      String?            @db.VarChar(255)
  content                    String?
  related_talent_category_id Int?
  related_activity_ids       Int[]
  generated_at               DateTime?          @default(now()) @db.Timestamp(6)
  viewed                     Boolean?           @default(false)
  confidence_score           Decimal?           @db.Decimal(3, 2)
  source                     String?            @db.VarChar(50)
  babies                     babies             @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  talent_categories          talent_categories? @relation(fields: [related_talent_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model appointments {
  id               Int          @id @default(autoincrement())
  user_id          Int?
  baby_id          Int?
  pregnancy_id     Int?
  appointment_type String?      @db.VarChar(50)
  title            String       @db.VarChar(255)
  description      String?
  appointment_date DateTime     @db.Timestamp(6)
  location         String?      @db.VarChar(255)
  reminder_sent    Boolean?     @default(false)
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
  updated_at       DateTime?    @default(now()) @db.Timestamp(6)
  babies           babies?      @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pregnancies      pregnancies? @relation(fields: [pregnancy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([appointment_date], map: "idx_appointments_appointment_date")
  @@index([user_id], map: "idx_appointments_user_id")
}

model article_bookmarks {
  id         Int       @id @default(autoincrement())
  user_id    Int
  article_id Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  articles   articles  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, article_id])
}

model article_reading_history {
  id         Int       @id @default(autoincrement())
  user_id    Int
  article_id Int
  read_at    DateTime? @default(now()) @db.Timestamp(6)
  articles   articles  @relation(fields: [article_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model articles {
  id                      Int                       @id @default(autoincrement())
  title                   String                    @db.VarChar(255)
  content                 String
  category                String?                   @db.VarChar(50)
  author                  String?                   @db.VarChar(255)
  image_url               String?
  video_url               String?
  reading_time_minutes    Int?
  is_featured             Boolean?                  @default(false)
  view_count              Int?                      @default(0)
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamp(6)
  language                String                    @default("en") @db.Char(2)
  doctor_name             String?                   @db.VarChar(255)
  doctor_credentials      String?                   @db.VarChar(255)
  age_min_months          Int?                      @default(0)
  age_max_months          Int?                      @default(60)
  doctor_verified         Boolean?                  @default(false)
  article_bookmarks       article_bookmarks[]
  article_reading_history article_reading_history[]

  @@index([age_min_months, age_max_months], map: "idx_articles_age_range")
  @@index([category], map: "idx_articles_category")
  @@index([language], map: "idx_articles_lang")
}

model assessment_answers {
  id                   Int                  @id @default(autoincrement())
  assessment_id        Int
  question_id          Int
  answer_value         String?
  created_at           DateTime?            @default(now()) @db.Timestamp(6)
  talent_assessments   talent_assessments   @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assessment_questions assessment_questions @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model assessment_questions {
  id                   Int                  @id @default(autoincrement())
  talent_category_id   Int
  question_text        String
  question_type        String?              @db.VarChar(50)
  options              Json?
  age_range_min_months Int?
  age_range_max_months Int?
  weight               Int?                 @default(1)
  created_at           DateTime?            @default(now()) @db.Timestamp(6)
  assessment_answers   assessment_answers[]
  talent_categories    talent_categories    @relation(fields: [talent_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model babies {
  id                                 Int                             @id @default(autoincrement())
  user_id                            Int
  name                               String                          @db.VarChar(255)
  birth_date                         DateTime                        @db.Date
  gender                             String?                         @db.VarChar(20)
  birth_weight_kg                    Decimal?                        @db.Decimal(5, 2)
  birth_height_cm                    Decimal?                        @db.Decimal(5, 2)
  profile_picture_url                String?
  avatar_url                         String?
  created_at                         DateTime?                       @default(now()) @db.Timestamp(6)
  updated_at                         DateTime?                       @default(now()) @db.Timestamp(6)
  ai_insights                        ai_insights[]
  appointments                       appointments[]
  users_babies_user_idTousers        users                           @relation("babies_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  baby_activities                    baby_activities[]
  baby_daily_activities              baby_daily_activities[]
  baby_material_recommendations      baby_material_recommendations[]
  baby_milestones                    baby_milestones[]
  daily_calorie_summary              daily_calorie_summary[]
  daily_meal_plans                   daily_meal_plans[]
  daily_plans                        daily_plans[]
  diaper_changes                     diaper_changes[]
  family_members                     family_members[]
  feedings                           feedings[]
  food_intake_logs                   food_intake_logs[]
  growth_records                     growth_records[]
  growth_stories                     growth_stories[]
  memories                           memories[]
  milestones                         milestones[]
  registries                         registries[]
  reminders                          reminders[]
  sleep_sessions                     sleep_sessions[]
  talent_assessments                 talent_assessments[]
  talent_missions                    talent_missions[]
  talent_progress                    talent_progress[]
  users_users_active_baby_idTobabies users[]                         @relation("users_active_baby_idTobabies")
  vaccinations                       vaccinations[]

  @@index([user_id], map: "idx_babies_user_id")
}

model baby_activities {
  id                  Int               @id @default(autoincrement())
  baby_id             Int
  activity_id         Int
  assigned_date       DateTime          @db.Date
  completed_date      DateTime?         @db.Date
  completion_notes    String?
  rating              Int?
  created_at          DateTime?         @default(now()) @db.Timestamp(6)
  updated_at          DateTime?         @default(now()) @db.Timestamp(6)
  difficulty_feedback String?           @db.VarChar(20)
  milestone_saved     Boolean?          @default(false)
  activity_videos     activity_videos[]
  activities          activities        @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  babies              babies            @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([baby_id], map: "idx_baby_activities_baby_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model baby_daily_activities {
  id           Int        @id @default(autoincrement())
  baby_id      Int
  plan_date    DateTime   @db.Date
  activity_id  Int
  slot         Int        @db.SmallInt
  is_completed Boolean    @default(false)
  completed_at DateTime?  @db.Timestamp(6)
  created_at   DateTime   @default(now()) @db.Timestamp(6)
  activities   activities @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  babies       babies     @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([baby_id, plan_date, slot])
  @@index([baby_id, plan_date], map: "idx_bda_baby_date")
}

model baby_material_recommendations {
  id               Int       @id @default(autoincrement())
  baby_id          Int
  material_id      Int
  recommended_date DateTime  @db.Date
  reason           String?
  viewed           Boolean?  @default(false)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  babies           babies    @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  materials        materials @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model baby_milestones {
  id                      Int                   @id @default(autoincrement())
  baby_id                 Int
  milestone_definition_id Int
  status                  String                @db.VarChar(10)
  achieved_date           DateTime?             @db.Date
  notes                   String?
  created_at              DateTime?             @default(now()) @db.Timestamp(6)
  updated_at              DateTime?             @default(now()) @db.Timestamp(6)
  babies                  babies                @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  milestone_definitions   milestone_definitions @relation(fields: [milestone_definition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([baby_id, milestone_definition_id])
  @@index([baby_id], map: "idx_baby_milestones_baby_id")
  @@index([milestone_definition_id], map: "idx_baby_milestones_def_id")
}

model bedtime_stories {
  id               Int               @id @default(autoincrement())
  title            String            @db.VarChar(255)
  description      String?
  content          String?
  category         String?           @db.VarChar(100)
  age_min_months   Int?
  age_max_months   Int?
  audio_url        String?
  image_url        String?
  duration_minutes Int?
  author           String?           @db.VarChar(255)
  is_featured      Boolean?          @default(false)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @default(now()) @db.Timestamp(6)
  language         String            @default("en") @db.Char(2)
  story_favorites  story_favorites[]

  @@index([age_min_months, age_max_months], map: "idx_bedtime_stories_age")
  @@index([category], map: "idx_bedtime_stories_category")
  @@index([language], map: "idx_bedtime_stories_lang")
}

model birth_club_memberships {
  id            Int         @id @default(autoincrement())
  user_id       Int
  birth_club_id Int
  joined_at     DateTime?   @default(now()) @db.Timestamp(6)
  birth_clubs   birth_clubs @relation(fields: [birth_club_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, birth_club_id])
}

model birth_clubs {
  id                     Int                      @id @default(autoincrement())
  birth_month            Int
  birth_year             Int
  club_name              String?                  @db.VarChar(255)
  member_count           Int?                     @default(0)
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  birth_club_memberships birth_club_memberships[]
  community_posts        community_posts[]
}

model birth_plans {
  id           Int          @id @default(autoincrement())
  user_id      Int
  pregnancy_id Int?
  plan_content String?
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  updated_at   DateTime?    @default(now()) @db.Timestamp(6)
  pregnancies  pregnancies? @relation(fields: [pregnancy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model bump_photos {
  id            Int         @id @default(autoincrement())
  pregnancy_id  Int
  photo_url     String
  thumbnail_url String?
  week_number   Int
  photo_date    DateTime    @db.Date
  notes         String?
  created_at    DateTime?   @default(now()) @db.Timestamp(6)
  updated_at    DateTime?   @default(now()) @db.Timestamp(6)
  pregnancies   pregnancies @relation(fields: [pregnancy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pregnancy_id], map: "idx_bump_photos_pregnancy_id")
}

model calorie_recommendations {
  id             Int       @id @default(autoincrement())
  age_min_months Int
  age_max_months Int
  gender         String?   @default("all") @db.VarChar(10)
  kcal_per_day   Int
  protein_g      Decimal?  @db.Decimal(5, 1)
  fat_g          Decimal?  @db.Decimal(5, 1)
  carbs_g        Decimal?  @db.Decimal(5, 1)
  calcium_mg     Decimal?  @db.Decimal(7, 1)
  iron_mg        Decimal?  @db.Decimal(5, 1)
  label          String?   @db.VarChar(100)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@index([age_min_months, age_max_months], map: "idx_calorie_rec_age")
}

model checklist_items {
  id           Int        @id @default(autoincrement())
  checklist_id Int
  item_text    String     @db.VarChar(255)
  is_checked   Boolean?   @default(false)
  item_order   Int?
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  updated_at   DateTime?  @default(now()) @db.Timestamp(6)
  checklists   checklists @relation(fields: [checklist_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model checklists {
  id              Int               @id @default(autoincrement())
  user_id         Int
  checklist_type  String            @db.VarChar(50)
  title           String            @db.VarChar(255)
  description     String?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  checklist_items checklist_items[]
  users           users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model class_enrollments {
  id             Int            @id @default(autoincrement())
  user_id        Int
  class_id       Int
  enrolled_at    DateTime?      @default(now()) @db.Timestamp(6)
  completed_at   DateTime?      @db.Timestamp(6)
  expert_classes expert_classes @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, class_id])
}

model community_posts {
  id            Int             @id @default(autoincrement())
  user_id       Int
  birth_club_id Int?
  post_type     String?         @default("discussion") @db.VarChar(50)
  title         String          @db.VarChar(255)
  content       String
  image_url     String?
  like_count    Int?            @default(0)
  comment_count Int?            @default(0)
  is_pinned     Boolean?        @default(false)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @default(now()) @db.Timestamp(6)
  birth_clubs   birth_clubs?    @relation(fields: [birth_club_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post_comments post_comments[]
  post_likes    post_likes[]

  @@index([birth_club_id], map: "idx_community_posts_birth_club_id")
  @@index([created_at], map: "idx_community_posts_created_at")
}

model content_topic_associations {
  id             Int            @id @default(autoincrement())
  topic_id       Int
  content_type   String         @db.VarChar(50)
  content_id     Int
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  content_topics content_topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([topic_id, content_type, content_id])
  @@index([content_type, content_id], map: "idx_content_topic_assoc_content")
  @@index([topic_id], map: "idx_content_topic_assoc_topic")
}

model content_topics {
  id                         Int                          @id @default(autoincrement())
  name                       String                       @unique @db.VarChar(100)
  description                String?
  icon_url                   String?
  slug                       String?                      @unique @db.VarChar(100)
  created_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?                    @default(now()) @db.Timestamp(6)
  content_topic_associations content_topic_associations[]
}

model contractions {
  id               Int         @id @default(autoincrement())
  pregnancy_id     Int
  contraction_time DateTime    @db.Timestamp(6)
  duration_seconds Int?
  intensity        Int?
  notes            String?
  created_at       DateTime?   @default(now()) @db.Timestamp(6)
  pregnancies      pregnancies @relation(fields: [pregnancy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model daily_calorie_summary {
  id             Int       @id @default(autoincrement())
  baby_id        Int?
  user_id        Int
  summary_date   DateTime  @db.Date
  total_calories Decimal?  @default(0) @db.Decimal(8, 2)
  total_protein  Decimal?  @default(0) @db.Decimal(8, 2)
  total_fat      Decimal?  @default(0) @db.Decimal(8, 2)
  total_carbs    Decimal?  @default(0) @db.Decimal(8, 2)
  meal_count     Int?      @default(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  babies         babies?   @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([baby_id, summary_date])
  @@unique([user_id, summary_date, baby_id])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model daily_meal_plans {
  id         Int       @id @default(autoincrement())
  user_id    Int
  baby_id    Int?
  plan_type  String    @default("baby") @db.VarChar(10)
  plan_date  DateTime  @db.Date
  meal_slot  String    @db.VarChar(30)
  recipe_id  Int?
  notes      String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  babies     babies?   @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes    recipes?  @relation(fields: [recipe_id], references: [id], onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, baby_id, plan_type, plan_date, meal_slot])
  @@index([user_id, plan_date], map: "idx_daily_plans_user_date")
}

model daily_plans {
  id         Int       @id @default(autoincrement())
  baby_id    Int
  plan_date  DateTime  @db.Date
  activities Int[]
  status     String?   @default("pending") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  babies     babies    @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([baby_id, plan_date])
  @@index([baby_id], map: "idx_daily_plans_baby_id")
  @@index([plan_date], map: "idx_daily_plans_plan_date")
}

model daily_updates_content {
  id            Int       @id @default(autoincrement())
  age_in_months Int
  content_type  String    @db.VarChar(50)
  title         String?   @db.VarChar(255)
  content       String
  image_url     String?
  video_url     String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  language      String    @default("en") @db.Char(2)

  @@index([language], map: "idx_daily_updates_lang")
}

model diaper_changes {
  id          Int       @id @default(autoincrement())
  baby_id     Int
  change_time DateTime  @db.Timestamp(6)
  diaper_type String    @db.VarChar(20)
  notes       String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  babies      babies    @relation(fields: [baby_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([baby_id], map: "idx_diaper_changes_baby_id")
  @@index([change_time], map: "idx_diaper_changes_change_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model doctor_profiles {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique
  specialty      String    @db.VarChar(100)
  license_number String?   @db.VarChar(100)
  hospital       String?   @db.VarChar(255)
  grade          String    @default("intern") @db.VarChar(50)
  grade_level    Int?      @default(1)
  bio            String?
  verified       Boolean?  @default(false)
  verified_at    DateTime? @db.Timestamp(6)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
