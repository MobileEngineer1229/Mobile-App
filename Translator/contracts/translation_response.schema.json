{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranslationResponse",
  "type": "object",
  "required": ["ok"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "sourceText": {
      "type": "string"
    },
    "translatedText": {
      "type": "string"
    },
    "detectedLanguage": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "type": "string"
    }
  }
}
