<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ── Configurations ─────────────────────────────────────── -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- ── Globals ────────────────────────────────────────────── -->
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <RootNamespace>AgarServer</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>
    <!-- vcpkg manifest mode: packages installed to vcpkg_installed\ next to vcpkg.json -->
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
    <VcpkgManifestEnabled>true</VcpkgManifestEnabled>
    <VcpkgRoot>$(SolutionDir)..\..\vcpkg</VcpkgRoot>
    <!-- Manifest-mode installed directory (next to vcpkg.json) -->
    <VcpkgInstalled>$(SolutionDir)vcpkg_installed\x64-windows</VcpkgInstalled>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- ── Configuration properties ──────────────────────────── -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v141</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v141</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- ── vcpkg integration ──────────────────────────────────── -->
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props"
          Condition="Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props')" />

  <!-- ── Output paths ───────────────────────────────────────── -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>

  <!-- ── Protobuf pre-build step ────────────────────────────── -->
  <PropertyGroup>
    <ProtoFile>$(SolutionDir)..\..\proto\agario.proto</ProtoFile>
    <ProtoOutDir>$(IntDir)proto_gen\</ProtoOutDir>
    <!-- No trailing backslash — avoids the batch "path\" escaped-quote bug -->
    <ProtoOutDirNS>$(IntDir)proto_gen</ProtoOutDirNS>
    <ProtoDir>$(SolutionDir)..\..\proto</ProtoDir>
    <ProtocExe>$(SolutionDir)vcpkg_installed\x64-windows\tools\protobuf\protoc.exe</ProtocExe>
  </PropertyGroup>

  <!-- ── Debug compiler settings ───────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>
        ..\src;
        $(IntDir)proto_gen;
        $(VcpkgInstalled)\include;
        $(VcpkgInstalled)\include\mongocxx\v_noabi;
        $(VcpkgInstalled)\include\bsoncxx\v_noabi;
        $(SolutionDir)..\vendor\entt\single_include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        WIN32;_DEBUG;_CONSOLE;
        _WIN32_WINNT=0x0A00;
        NOMINMAX;
        _CRT_SECURE_NO_WARNINGS;
        BOOST_DATE_TIME_NO_LIB;
        _SILENCE_ALL_CXX17_DEPRECATION_WARNINGS;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>
        $(VcpkgInstalled)\debug\lib;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        ws2_32.lib;wsock32.lib;Iphlpapi.lib;
        libprotobufd.lib;libprotobuf-lited.lib;
        mongocxx-v_noabi-dhi-mdd.lib;bsoncxx-v_noabi-dhi-mdd.lib;
        hiredisd.lib;
        datachannel.lib;
        libssl.lib;libcrypto.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
    <PreBuildEvent>
      <Command>if not exist "$(ProtoOutDirNS)" mkdir "$(ProtoOutDirNS)"
"$(ProtocExe)" --cpp_out=$(ProtoOutDirNS) --proto_path=$(ProtoDir) $(ProtoFile)</Command>
      <Message>Generating protobuf sources...</Message>
    </PreBuildEvent>
    <PostBuildEvent>
      <Command>xcopy /Y /Q "$(SolutionDir)vcpkg_installed\x64-windows\bin\*.dll" "$(OutDir)"</Command>
      <Message>Copying runtime DLLs...</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <!-- ── Release compiler settings ─────────────────────────── -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>
        ..\src;
        $(IntDir)proto_gen;
        $(VcpkgInstalled)\include;
        $(VcpkgInstalled)\include\mongocxx\v_noabi;
        $(VcpkgInstalled)\include\bsoncxx\v_noabi;
        $(SolutionDir)..\vendor\entt\single_include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        WIN32;NDEBUG;_CONSOLE;
        _WIN32_WINNT=0x0A00;
        NOMINMAX;
        _CRT_SECURE_NO_WARNINGS;
        BOOST_DATE_TIME_NO_LIB;
        _SILENCE_ALL_CXX17_DEPRECATION_WARNINGS;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>
        $(VcpkgInstalled)\lib;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        ws2_32.lib;wsock32.lib;Iphlpapi.lib;
        libprotobuf.lib;
        mongocxx-v_noabi-rhi-md.lib;bsoncxx-v_noabi-rhi-md.lib;
        hiredis.lib;
        datachannel.lib;
        libssl.lib;libcrypto.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
    <PreBuildEvent>
      <Command>if not exist "$(ProtoOutDirNS)" mkdir "$(ProtoOutDirNS)"
"$(ProtocExe)" --cpp_out=$(ProtoOutDirNS) --proto_path=$(ProtoDir) $(ProtoFile)</Command>
      <Message>Generating protobuf sources...</Message>
    </PreBuildEvent>
    <PostBuildEvent>
      <Command>xcopy /Y /Q "$(SolutionDir)vcpkg_installed\x64-windows\bin\*.dll" "$(OutDir)"</Command>
      <Message>Copying runtime DLLs...</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <!-- ── Source files ───────────────────────────────────────── -->
  <ItemGroup>
    <ClCompile Include="..\src\main.cpp" />
    <ClCompile Include="..\src\SpatialGrid.cpp" />
    <ClCompile Include="..\src\Systems.cpp" />
    <ClCompile Include="..\src\GameLoop.cpp" />
    <ClCompile Include="..\src\Database.cpp" />
    <ClCompile Include="..\src\RedisClient.cpp" />
    <ClCompile Include="..\src\PacketSerializer.cpp" />
    <ClCompile Include="..\src\TcpServer.cpp" />
    <ClCompile Include="..\src\UdpServer.cpp" />
    <ClCompile Include="..\src\Player.cpp" />
    <!-- Generated protobuf source (added after first pre-build) -->
    <ClCompile Include="$(IntDir)proto_gen\agario.pb.cc">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
  </ItemGroup>

  <!-- ── Header files ───────────────────────────────────────── -->
  <ItemGroup>
    <ClInclude Include="..\src\Config.h" />
    <ClInclude Include="..\src\Vec2.h" />
    <ClInclude Include="..\src\Components.h" />
    <ClInclude Include="..\src\SpatialGrid.h" />
    <ClInclude Include="..\src\Systems.h" />
    <ClInclude Include="..\src\GameLoop.h" />
    <ClInclude Include="..\src\Database.h" />
    <ClInclude Include="..\src\RedisClient.h" />
    <ClInclude Include="..\src\PacketSerializer.h" />
    <ClInclude Include="..\src\TcpServer.h" />
    <ClInclude Include="..\src\UdpServer.h" />
    <ClInclude Include="..\src\Player.h" />
    <ClInclude Include="..\src\Food.h" />
    <ClInclude Include="..\src\World.h" />
  </ItemGroup>

  <!-- ── Proto file ─────────────────────────────────────────── -->
  <ItemGroup>
    <None Include="..\..\proto\agario.proto" />
    <None Include="vcpkg.json" />
  </ItemGroup>

  <!-- ── vcpkg targets ──────────────────────────────────────── -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets"
          Condition="Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')" />

</Project>
